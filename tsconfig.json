{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun", "vite/client"],
    "paths": { "@/*": ["./src/*"], "@shared/*": ["./shared/*"] }
  },
  // `examples` is in here on purpose, even though it is nobody's runtime code.
  // The reference solver is the thing agent authors copy, so it going stale is
  // worse than it being absent — it was already calling an endpoint that had
  // stopped accepting it. Typechecking it means `bun run build` needs
  // playwright installed, which is why it is a devDependency rather than a
  // suggestion in a README.
  "include": ["src", "shared", "server", "worker", "scripts", "examples", "vite.config.ts"]
}
