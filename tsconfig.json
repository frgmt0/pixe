{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun", "vite/client"],
    "paths": { "@/*": ["./src/*"], "@shared/*": ["./shared/*"] }
  },
  // `examples/` used to be in here on purpose: it held a reference Playwright
  // solver, and a stale example an agent author copies is worse than no
  // example. It went out with the browser. Whatever replaces it — a runner
  // script against the JSON API — belongs back in this list for the same
  // reason.
  "include": ["src", "shared", "server", "worker", "scripts", "vite.config.ts"]
}
